- name: decider
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nGPS acquisition - decider (Embedded Python Block)\n\nInputs\
      \ : the two stock acquisition branches, each a 2048-float vector per 20 ms\n\
      \         (|correlation|^2 at all 2048 code phases, 20 ms non-coherent sum).\n\
      \         in0 = Doppler m kHz, in1 = m kHz + 500 Hz. Each vector carries the\n\
      \         'acq' = (prn, m) tag from the taps scheduler.\nBuilds the 42-row Doppler\
      \ x 2048 code-phase grid for one PRN, then decides:\n         peak/mean > threshold\
      \ -> parabolic Doppler refinement -> 'assign' message\n         to a free tracking\
      \ channel.\nMessages out: assign (dict), corr / dopp / acq (float PDUs for QT\
      \ Time Sinks).\nMessage in  : status (from trackers: 'lost' frees a channel).\n\
      A candidate must pass two tests: peak/mean > threshold, and the 20 ms sum must\
      \ have\naveraged at least min_dof independent milliseconds (rejects periodic\
      \ interference).\n\nWhy an EPB: collecting a 2-D grid across time, picking a\
      \ peak with a decision rule\nand handing a timing reference to another block\
      \ has no stock equivalent.\n\"\"\"\nimport time\nimport numpy as np\nfrom gnuradio\
      \ import gr\nimport pmt\n\n\nclass blk(gr.sync_block):\n    \"\"\"GPS acq decider:\
      \ grid -> peak/mean -> assign a tracking channel\"\"\"\n\n    def __init__(self,\
      \ samp_rate=2.048e6, m_max=10, n_noncoh=20, threshold=3.5, n_ch=4,\n       \
      \          min_dof=5.0):\n        self.N = int(round(samp_rate * 1e-3))\n  \
      \      gr.sync_block.__init__(self, name='GPS acq decider',\n              \
      \                 in_sig=[(np.float32, self.N), (np.float32, self.N)],\n   \
      \                            out_sig=None)\n        self.fs = float(samp_rate)\n\
      \        self.m_max = int(m_max)\n        self.K = int(n_noncoh)\n        self.thr\
      \ = float(threshold)\n        self.n_ch = int(n_ch)\n        self.min_dof =\
      \ float(min_dof)\n        self.t_warn = 0.0\n        self.busy = {}        \
      \               # ch -> prn\n        self.metric = np.zeros(32, np.float32)\n\
      \        self.cur = None\n        self.rows = {}\n        for p in ('assign',\
      \ 'corr', 'dopp', 'acq'):\n            self.message_port_register_out(pmt.intern(p))\n\
      \        self.message_port_register_in(pmt.intern('status'))\n        self.set_msg_handler(pmt.intern('status'),\
      \ self._status)\n\n    def _status(self, msg):\n        d = pmt.to_python(msg)\n\
      \        if isinstance(d, dict) and d.get('event') == 'lost':\n            self.busy.pop(int(d['ch']),\
      \ None)\n\n    def work(self, input_items, output_items):\n        a, b = input_items\n\
      \        base = self.nitems_read(0)\n        tags = self.get_tags_in_window(0,\
      \ 0, len(a), pmt.intern('acq'))\n        lab = {t.offset - base: pmt.to_python(t.value)\
      \ for t in tags}\n        for j in range(len(a)):\n            if j not in lab:\n\
      \                continue                      # unlabelled (should not happen)\n\
      \            prn, m = int(lab[j][0]), int(lab[j][1])\n            if prn ==\
      \ 0:\n                continue                      # warm-up window\n     \
      \       w = base + j                      # window index: ms [w*K, w*K+K)\n\
      \            if self.cur is not None and prn != self.cur:\n                self.rows\
      \ = {}                # partial sweep (scheduler skipped ahead)\n          \
      \  self.cur = prn\n            s_mid = (w * self.K + self.K // 2) * self.N \
      \   # sample at window middle\n            # each row normalised by its own\
      \ mean: immune to slow level changes (AGC)\n            self.rows[m * 1000]\
      \ = (a[j] / max(a[j].mean(), 1e-30), s_mid)\n            self.rows[m * 1000\
      \ + 500] = (b[j] / max(b[j].mean(), 1e-30), s_mid)\n            if m == self.m_max:\n\
      \                if len(self.rows) == 2 * (2 * self.m_max + 1):\n          \
      \          self._decide(prn)\n                self.rows, self.cur = {}, None\n\
      \        return len(a)\n\n    def _decide(self, prn):\n        freqs = sorted(self.rows)\n\
      \        G = np.array([self.rows[f][0] for f in freqs])\n        mean = G.mean()\n\
      \        d, tau = np.unravel_index(np.argmax(G), G.shape)\n        metric =\
      \ G[d, tau] / mean\n        self.metric[prn - 1] = metric\n        f = float(freqs[d])\n\
      \        if 0 < d < len(freqs) - 1:            # neighbours: best value within\
      \ +-2 samples\n            win = [(tau + k) % self.N for k in range(-2, 3)]\n\
      \            y0, y1, y2 = G[d - 1, win].max(), G[d, tau], G[d + 1, win].max()\n\
      \            den = y0 - 2 * y1 + y2\n            if den < 0:\n             \
      \   f += 0.5 * (y0 - y2) / den * 500.0\n        # second test: did the 20 ms\
      \ sum really average 20 independent milliseconds?\n        # In white noise\
      \ each cell is a sum of n_noncoh independent |corr|^2 values, so the\n     \
      \   # row (peak excluded) has variance 1/n_noncoh -> effective dof = 1/var ~\
      \ 20.\n        # Interference that repeats every 1 ms or 125 us (USB / digital\
      \ noise from the\n        # dongle, laptop or bias-tee supply), or a strong\
      \ CW spur, is IDENTICAL in every\n        # millisecond: the sum averages nothing,\
      \ dof collapses to ~1, and peak/mean reaches\n        # ~ln(86000) = 11 for\
      \ EVERY PRN. Those are rejected here.\n        mask = np.ones(self.N, bool)\n\
      \        mask[[(tau + k) % self.N for k in range(-3, 4)]] = False\n        rest\
      \ = G[d, mask]\n        dof = 1.0 / max(np.var(rest / rest.mean()), 1e-9)\n\
      \        ratio = G[d, tau] / rest.max()\n        self._pub('corr', G[d] / mean)\n\
      \        self._pub('dopp', G[:, tau] / mean)\n        self._pub('acq', self.metric)\n\
      \        if metric < self.thr or prn in self.busy.values():\n            return\n\
      \        if dof < self.min_dof:\n            now = time.time()\n           \
      \ if now - self.t_warn > 5.0:\n                self.t_warn = now\n         \
      \       print('[INTERFERENCE] PRN %02d peak/mean %.1f rejected: the %d ms sum\
      \ behaves like '\n                      '%.1f independent ms (white noise: ~%d).\
      \ Something repeats every 1 ms: '\n                      'look for a picket\
      \ fence on the raw spectrum.' % (prn, metric, self.K, dof,\n               \
      \                                                          self.K), flush=True)\n\
      \            return\n        free = [c for c in range(self.n_ch) if c not in\
      \ self.busy]\n        if not free:\n            return\n        ch = free[0]\n\
      \        s_ref = int(self.rows[freqs[d]][1] + tau)   # a code epoch (chip 0)\
      \ sample index\n        self.busy[ch] = prn\n        # s_ref goes out as a float:\
      \ it passes 2^31 after 17.5 min, and pmt.to_pmt() turns a\n        # Python\
      \ int into a C long, which is 32-bit on Windows. A double is exact to 2^53.\n\
      \        self.message_port_pub(pmt.intern('assign'), pmt.to_pmt(\n         \
      \   {'event': 'assign', 'ch': ch, 'prn': prn, 'f': f, 's_ref': float(s_ref)}))\n\
      \        print('[ACQ] PRN %02d -> ch%d  Doppler %+7.0f Hz  code epoch at sample\
      \ %d  '\n              'peak/mean %.1f  peak/2nd %.2f  dof %.0f' % (prn, ch,\
      \ f, s_ref, metric, ratio, dof), flush=True)\n\n    def _pub(self, port, v):\n\
      \        v = np.asarray(v, np.float32)\n        self.message_port_pub(pmt.intern(port),\n\
      \                              pmt.cons(pmt.PMT_NIL, pmt.init_f32vector(len(v),\
      \ v.tolist())))\n"
    affinity: ''
    alias: ''
    comment: 'Decider (EPB): builds the PRN grid, peak/mean, assigns channels'
    m_max: m_max
    maxoutbuf: '0'
    min_dof: '5.0'
    minoutbuf: '0'
    n_ch: '4'
    n_noncoh: n_noncoh
    samp_rate: samp_rate
    threshold: threshold
  states:
    _io_cache: '(''GPS acq decider'', ''blk'', [(''samp_rate'', ''2048000.0''), (''m_max'',
      ''10''), (''n_noncoh'', ''20''), (''threshold'', ''3.5''), (''n_ch'', ''4''),
      (''min_dof'', ''5.0'')], [(''0'', ''float'', 2048), (''1'', ''float'', 2048),
      (''status'', ''message'', 1)], [(''acq'', ''message'', 1), (''dopp'', ''message'',
      1), (''corr'', ''message'', 1), (''assign'', ''message'', 1)], ''GPS acq decider:
      grid -> peak/mean -> assign a tracking channel'', [''m_max'', ''min_dof'', ''n_ch''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 360]
    rotation: 0
    state: enabled
