    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 100]
    rotation: 0
    state: enabled
- name: ppm
  id: variable_qtgui_range
  parameters:
    comment: 'TCXO dongle: 0'
    gui_hint: 0,1,1,1
    label: Freq corr [ppm]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-100'
    step: '1'
    stop: '100'
    value: '35'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 12]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: Active antenna LNA sets the noise figure
    gui_hint: 0,0,1,1
    label: RF gain [dB]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '40.2'
