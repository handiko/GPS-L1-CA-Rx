    gui_hint: 0,2,1,1
    label: Park search on PRN (0 = auto)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '32'
    value: '0'
    widget: counter_slider
