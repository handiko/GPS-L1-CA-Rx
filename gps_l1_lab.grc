options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Lab version of gps_l1_despread: stock acquisition branches + 3 EPBs
      + 3 hier blocks'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gps_l1_lab
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'GPS L1 C/A lab: acquisition and tracking, every stage probed'
    window_size: (1200,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: ''
    value: int(round(samp_rate*1e-3))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [340, 12]
    rotation: 0
    state: enabled
- name: base_path
  id: variable
  parameters:
    comment: Path WITHOUT extension. Use forward slashes on Windows.
    value: '"C:/Users/Handiko/Downloads/GPS-L1-2022-03-27"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 824.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: GPS L1
    value: 1575.42e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 76]
    rotation: 0
    state: enabled
- name: center_freq_0
  id: variable
  parameters:
    comment: ''
    value: float(meta['captures'][0].get('core:frequency', 0))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 752.0]
    rotation: 0
    state: enabled
- name: chips_per_sample
  id: variable
  parameters:
    comment: x-axis scale for code-phase plots
    value: 1.023e6/samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 76]
    rotation: 0
    state: enabled
- name: datatype
  id: variable_qtgui_label
  parameters:
    comment: Shows core:datatype so you know which chain to enable
    formatter: None
    gui_hint: ''
    label: core:datatype
    type: string
    value: meta['global']['core:datatype']
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 936.0]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: display path 2.048 MS/s -> 64 kS/s
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [620, 12]
    rotation: 0
    state: enabled
- name: disp_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [620, 76]
    rotation: 0
    state: enabled
- name: file_samp_rate
  id: variable
  parameters:
    comment: ''
    value: float(meta['global']['core:sample_rate'])
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 872.0]
    rotation: 0
    state: enabled
- name: lpf_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.low_pass(1.0, samp_rate, 22e3, 16e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: m_max
  id: variable
  parameters:
    comment: 'Doppler search +-m_max kHz (TCXO dongle: 6 is enough)'
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 12]
    rotation: 0
    state: enabled
- name: meta
  id: variable
  parameters:
    comment: Parsed .sigmf-meta JSON
    value: json.load(open(base_path + '.sigmf-meta'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 952.0]
    rotation: 0
    state: enabled
- name: n_noncoh
  id: variable
  parameters:
    comment: 'acquisition: 1 ms correlations summed per Doppler bin'
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [340, 76]
    rotation: 0
    state: enabled
- name: park_khz
  id: variable_qtgui_range
  parameters:
    comment: Doppler of the parked search, whole kHz (branch 2 adds +0.5 kHz)
    gui_hint: 0,3,1,1
    label: Park Doppler [kHz]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: -m_max
    step: '1'
    stop: m_max
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 100]
    rotation: 0
    state: enabled
- name: park_prn
  id: variable_qtgui_range
  parameters:
    comment: 'PARK mode for the acquisition probes: 1..32 holds the search on that
