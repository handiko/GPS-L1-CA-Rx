- name: navdec
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nGPS navigation message decoder (Embedded Python Block)\n\
      \nInputs : n_ch byte streams at 50 bit/s, one per tracking channel, from the\
      \ stock\n         gps_nav_bits hier blocks (bit sync -> differential detection\
      \ -> differential\n         encoder -> preamble taggers). Bits are correct up\
      \ to one overall inversion.\n         Stream tags 'preamble' / 'preamble_inv'\
      \ mark each 10001011 (or 01110100)\n         found by the stock Correlate Access\
      \ Code - Tag blocks.\nMessage in  'status' : tracker events {'event','ch','prn'}\
      \ -> reset that channel.\nMessage out 'text'   : the latest decoded line (for\
      \ a QT GUI Message Edit Box).\n\nWhat it does per channel (IS-GPS-200):\n  1.\
      \ Frame sync: a tagged preamble is only a candidate (8 bits occur by chance\
      \ every\n     ~256 bits). It is accepted when TLM and HOW pass the 6-bit parity\
      \ check, and the\n     NEXT subframe, 300 bits later, also passes. Polarity\
      \ comes from which tag fired.\n  2. Every following 300-bit subframe: parity\
      \ on all 10 words, then decode\n     HOW: TOW count (time of week, 6 s units)\
      \ and subframe ID 1..5\n     subframe 1 word 3: 10-bit week number, SV health,\
      \ URA index, IODC MSBs.\n  3. GPS time -> UTC (GPS - 18 s leap seconds; the\
      \ 10-bit week is unwrapped with\n     2 rollovers, valid 2019-04-07 .. 2038-11-20).\n\
      \nWhy an EPB: parity checking with the D29*/D30* chaining, frame validation\
      \ across\nsubframes and field decoding have no stock GNU Radio equivalent.\n\
      \"\"\"\nimport datetime\nimport numpy as np\nfrom gnuradio import gr\nimport\
      \ pmt\n\nPREAMBLE = [1, 0, 0, 0, 1, 0, 1, 1]\nLEAP_S = 18\nGPS_EPOCH = datetime.datetime(1980,\
      \ 1, 6)\n# parity equations: which data bits (1-based) feed each parity bit,\
      \ and whether D29* or D30*\nPAR = [(29, [1, 2, 3, 5, 6, 10, 11, 12, 13, 14,\
      \ 17, 18, 20, 23]),\n       (30, [2, 3, 4, 6, 7, 11, 12, 13, 14, 15, 18, 19,\
      \ 21, 24]),\n       (29, [1, 3, 4, 5, 7, 8, 12, 13, 14, 15, 16, 19, 20, 22]),\n\
      \       (30, [2, 4, 5, 6, 8, 9, 13, 14, 15, 16, 17, 20, 21, 23]),\n       (30,\
      \ [1, 3, 5, 6, 7, 9, 10, 14, 15, 16, 17, 18, 21, 22, 24]),\n       (29, [3,\
      \ 5, 6, 8, 9, 10, 11, 13, 15, 19, 22, 23, 24])]\n\n\ndef word_ok(w30, d29s,\
      \ d30s):\n    \"\"\"w30: 30 transmitted bits. Returns (ok, 24 source data bits).\"\
      \"\"\n    data = [b ^ d30s for b in w30[:24]]\n    star = {29: d29s, 30: d30s}\n\
      \    for k, (s, idx) in enumerate(PAR):\n        p = star[s]\n        for i\
      \ in idx:\n            p ^= data[i - 1]\n        if p != w30[24 + k]:\n    \
      \        return False, data\n    return True, data\n\n\ndef subframe_check(bits,\
      \ d29s, d30s, n_words=10):\n    \"\"\"bits: 300 transmitted bits (polarity already\
      \ corrected). Returns list of\n    24-bit data words, or None if any parity\
      \ check fails.\"\"\"\n    words = []\n    for w in range(n_words):\n       \
      \ w30 = bits[30 * w:30 * w + 30]\n        ok, data = word_ok(w30, d29s, d30s)\n\
      \        if not ok:\n            return None\n        words.append(data)\n \
      \       d29s, d30s = w30[28], w30[29]\n    return words\n\n\ndef words_check(bits,\
      \ d29s, d30s):\n    \"\"\"all 10 words; returns (data words, list of per-word\
      \ parity results)\"\"\"\n    words, ok = [], []\n    for w in range(10):\n \
      \       w30 = bits[30 * w:30 * w + 30]\n        good, data = word_ok(w30, d29s,\
      \ d30s)\n        words.append(data)\n        ok.append(good)\n        d29s,\
      \ d30s = w30[28], w30[29]\n    return words, ok\n\n\ndef uint(bits):\n    v\
      \ = 0\n    for b in bits:\n        v = (v << 1) | int(b)\n    return v\n\n\n\
      def gps_to_utc(week_full, tow_s):\n    return GPS_EPOCH + datetime.timedelta(weeks=week_full,\
      \ seconds=tow_s - LEAP_S)\n\n\nclass blk(gr.sync_block):\n    \"\"\"GPS nav\
      \ decoder: frame sync, parity, TOW / subframe / week number -> UTC\"\"\"\n\n\
      \    def __init__(self, n_ch=4):\n        self.n = int(n_ch)\n        gr.sync_block.__init__(self,\
      \ name='GPS nav decoder',\n                               in_sig=[np.uint8]\
      \ * self.n, out_sig=None)\n        self.message_port_register_in(pmt.intern('status'))\n\
      \        self.set_msg_handler(pmt.intern('status'), self._status)\n        self.message_port_register_out(pmt.intern('text'))\n\
      \        self.st = [self._fresh(None) for _ in range(self.n)]\n\n    @staticmethod\n\
      \    def _fresh(prn):\n        return dict(prn=prn, buf=[], base=0, cands=[],\
      \ lock=None, pol=0, week=None,\n                    n_ok=0, n_bad=0)\n\n   \
      \ def _status(self, msg):\n        d = pmt.to_python(msg)\n        if isinstance(d,\
      \ dict) and 0 <= int(d.get('ch', -1)) < self.n:\n            ch = int(d['ch'])\n\
      \            self.st[ch] = self._fresh(int(d['prn']) if d.get('event') == 'assigned'\
      \ else None)\n\n    def _say(self, line):\n        print(line, flush=True)\n\
      \        self.message_port_pub(pmt.intern('text'), pmt.intern(line))\n\n   \
      \ def work(self, input_items, output_items):\n        n = len(input_items[0])\n\
      \        for c in range(self.n):\n            st = self.st[c]\n            r0\
      \ = self.nitems_read(c)\n            if not st['buf']:\n                st['base']\
      \ = r0\n            st['buf'].extend(int(b) & 1 for b in input_items[c])\n \
      \           for key, pol in (('preamble', 0), ('preamble_inv', 1)):\n      \
      \          for t in self.get_tags_in_window(c, 0, n, pmt.intern(key)):\n   \
      \                 # tag sits on the bit after the 8-bit code -> subframe starts\
      \ 8 earlier\n                    st['cands'].append((t.offset - 8, pol))\n \
      \           if st['prn'] is not None:\n                self._process(c, st)\n\
      \            else:\n                st['cands'] = []\n            keep = 900\
      \                                # bits kept (3 subframes)\n            if len(st['buf'])\
      \ > keep + 1200:\n                drop = len(st['buf']) - keep\n           \
      \     st['buf'] = st['buf'][drop:]\n                st['base'] += drop\n   \
      \     return n\n\n    def _get(self, st, start, length):\n        i = start\
      \ - st['base']\n        if i < 0 or i + length > len(st['buf']):\n         \
      \   return None\n        return st['buf'][i:i + length]\n\n    def _process(self,\
      \ c, st):\n        if st['lock'] is None:                       # frame sync\
      \ from candidates\n            still = []\n            for (s, pol) in st['cands']:\n\
      \                seg = self._get(st, s - 2, 602)       # D29*, D30* + two subframes\n\
      \                if seg is None:\n                    if s - 2 >= st['base']:\n\
      \                        still.append((s, pol))         # wait for more bits\n\
      \                    continue\n                seg = [b ^ pol for b in seg]\n\
      \                a = words_check(seg[2:302], seg[0], seg[1])[1]\n          \
      \      b = words_check(seg[302:602], seg[300], seg[301])[1]\n              \
      \  pre2 = seg[302:310] in (PREAMBLE, [x ^ 1 for x in PREAMBLE])\n          \
      \      if a[0] and a[1] and b[0] and b[1] and pre2:\n                    st['lock'],\
      \ st['pol'] = s, pol\n                    self._say('[NAV ch%d] PRN %02d frame\
      \ sync: preamble at bit %d, polarity %s, '\n                              'TLM+HOW\
      \ parity OK on two consecutive subframes' % (\n                            \
      \      c, st['prn'], s, 'inverted' if pol else 'normal'))\n                \
      \    break\n            else:\n                st['cands'] = still\n       \
      \     if st['lock'] is None:\n                return\n            st['cands']\
      \ = []\n        while True:                                   # decode every\
      \ complete subframe\n            s = st['lock']\n            seg = self._get(st,\
      \ s - 2, 302)\n            if seg is None:\n                return\n       \
      \     st['lock'] = s + 300\n            # polarity per subframe from its own\
      \ preamble: differential detection makes\n            # every misread transition\
      \ invert all later bits. GPS parity survives that by\n            # design (each\
      \ word is checked against the previous word's last two RECEIVED\n          \
      \  # bits), so only the word containing the flip is lost.\n            if seg[2:10]\
      \ == PREAMBLE:\n                pol = 0\n            elif [b ^ 1 for b in seg[2:10]]\
      \ == PREAMBLE:\n                pol = 1\n            else:\n               \
      \ pol = None\n            words, ok = words_check(seg[2:302], seg[0], seg[1])\
      \ if pol is not None else (None, [False] * 10)\n            if not (ok[0] and\
      \ ok[1]):                 # TLM + HOW are the minimum\n                st['n_bad']\
      \ += 1\n                self._say('[NAV ch%d] PRN %02d subframe at bit %d: TLM/HOW\
      \ parity FAIL (%d in a row)'\n                          % (c, st['prn'], s,\
      \ st['n_bad']))\n                if st['n_bad'] >= 3:                  # lost\
      \ frame sync: search again\n                    self._say('[NAV ch%d] PRN %02d\
      \ frame sync lost, searching' % (c, st['prn']))\n                    st['lock'],\
      \ st['n_bad'] = None, 0\n                    return\n                continue\n\
      \            st['n_bad'] = 0\n            st['n_ok'] += 1\n            self._decode(c,\
      \ st, words, ok)\n\n    def _decode(self, c, st, w, ok):\n        how = w[1]\n\
      \        tow_next = uint(how[0:17]) * 6               # TOW at start of NEXT\
      \ subframe\n        sfid = uint(how[19:22])\n        tow = tow_next - 6    \
      \                       # TOW at start of THIS subframe\n        extra = ''\n\
      \        bad = [i + 1 for i in range(10) if not ok[i]]\n        if bad:\n  \
      \          extra = '  (parity fail in word %s)' % ','.join(map(str, bad))\n\
      \        if sfid == 1 and ok[2]:\n            wn10 = uint(w[2][0:10])\n    \
      \        st['week'] = wn10 + 2048                 # two rollovers (since April\
      \ 2019)\n            ura, health, iodc_msb = uint(w[2][12:16]), uint(w[2][16:22]),\
      \ uint(w[2][22:24])\n            iodc = (iodc_msb << 8) | uint(w[7][0:8]) if\
      \ ok[7] else -1\n            extra += '  week %d (10-bit %d), URA %d, health\
      \ %s, IODC %d' % (\n                st['week'], wn10, ura, 'OK' if health ==\
      \ 0 else '0x%02X' % health, iodc)\n        d, rem = divmod(tow, 86400)\n   \
      \     hh, rem = divmod(rem, 3600)\n        mm, ss = divmod(rem, 60)\n      \
      \  dow = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][d % 7]\n        line\
      \ = '[NAV ch%d] PRN %02d subframe %d  TOW %6d s = %s %02d:%02d:%02d GPS%s' %\
      \ (\n            c, st['prn'], sfid, tow, dow, hh, mm, ss, extra)\n        if\
      \ st['week'] is not None:\n            line += '  -> UTC %s' % gps_to_utc(st['week'],\
      \ tow).strftime('%Y-%m-%d %H:%M:%S')\n        self._say(line)\n"
    affinity: ''
    alias: ''
    comment: 'Nav decoder (EPB): frame sync, parity, TOW, subframe ID, week -> UTC'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_ch: '4'
  states:
    _io_cache: '(''GPS nav decoder'', ''blk'', [(''n_ch'', ''4'')], [(''0'', ''byte'',
      1), (''1'', ''byte'', 1), (''2'', ''byte'', 1), (''3'', ''byte'', 1), (''status'',
      ''message'', 1)], [(''text'', ''message'', 1)], ''GPS nav decoder: frame sync,
      parity, TOW / subframe / week number -> UTC'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 1688.0]
    rotation: 0
    state: enabled
