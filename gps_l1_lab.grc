- name: sched
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nGPS acquisition - taps scheduler (Embedded Python Block)\n\
      \nClocked by the raw 2.048 MS/s stream: one output vector per 1 ms (2048 samples).\n\
      Output = the replica spectrum conj(FFT(C/A code)) of the PRN under test, circularly\n\
      rotated by m bins. With 1 kHz bin spacing (2048-pt FFT at 2.048 MS/s), rotating\
      \ the\ncode spectrum by m bins is the same as testing a Doppler of m kHz:\n\
      \    |IFFT( FFT(x * e^-j2pi m n/N) * C* )| = |IFFT( FFT(x) * roll(C*, m) )|\n\
      so the stock Multiply in the acquisition branches does the Doppler search too.\n\
      The half-kHz bins come from a second branch pre-mixed by -500 Hz.\n\nThe first\
      \ warmup_ms (default 500 ms) are tagged PRN 0 and ignored, while the AGC\nsettles.\
      \ After that, the hypothesis (PRN, m) changes only on 20 ms boundaries (aligned\
      \ with the stock\nIntegrate decim=20), and each change is stamped with a stream\
      \ tag 'acq' = (prn, m).\nThe tag rides through Multiply, IFFT, Mag^2 and Integrate\
      \ to the decider, so every\nintegrated result is labelled exactly: no guessing\
      \ about buffer latency.\n\nPARK mode (park_prn = 1..32): the scheduler holds\
      \ PRN park_prn at Doppler park_khz kHz\n(and park_khz + 0.5 kHz in the second\
      \ branch) so the 1 ms and 20 ms probes can be\nwatched. park_prn = 0 resumes\
      \ the automatic sweep. No decisions are made while parked.\n\nWhy an EPB: no\
      \ stock block produces a vector sequence that changes on a schedule\nand skips\
      \ PRNs that are already being tracked (message input 'status').\n\"\"\"\nimport\
      \ numpy as np\nfrom gnuradio import gr\nimport pmt\n\nG2_TAPS = {1: (2, 6),\
      \ 2: (3, 7), 3: (4, 8), 4: (5, 9), 5: (1, 9), 6: (2, 10),\n           7: (1,\
      \ 8), 8: (2, 9), 9: (3, 10), 10: (2, 3), 11: (3, 4), 12: (5, 6),\n         \
      \  13: (6, 7), 14: (7, 8), 15: (8, 9), 16: (9, 10), 17: (1, 4), 18: (2, 5),\n\
      \           19: (3, 6), 20: (4, 7), 21: (5, 8), 22: (6, 9), 23: (1, 3), 24:\
      \ (4, 6),\n           25: (5, 7), 26: (6, 8), 27: (7, 9), 28: (8, 10), 29: (1,\
      \ 6), 30: (2, 7),\n           31: (3, 8), 32: (4, 9)}\n\n\ndef ca_code(prn):\n\
      \    g1, g2 = [1] * 10, [1] * 10\n    a, b = G2_TAPS[prn]\n    out = np.empty(1023,\
      \ np.float32)\n    for i in range(1023):\n        out[i] = 1 - 2 * (g1[9] ^\
      \ g2[a - 1] ^ g2[b - 1])\n        g1 = [g1[2] ^ g1[9]] + g1[:9]\n        g2\
      \ = [g2[1] ^ g2[2] ^ g2[5] ^ g2[7] ^ g2[8] ^ g2[9]] + g2[:9]\n    return out\n\
      \n\nclass blk(gr.decim_block):\n    \"\"\"GPS acq taps scheduler: conj(FFT(code))\
      \ rotated by Doppler, tagged (prn, m)\"\"\"\n\n    def __init__(self, samp_rate=2.048e6,\
      \ m_max=10, n_noncoh=20, warmup_ms=500,\n                 park_prn=0, park_khz=0):\n\
      \        self.N = int(round(samp_rate * 1e-3))\n        gr.decim_block.__init__(self,\
      \ name='GPS acq taps scheduler',\n                                in_sig=[np.complex64],\n\
      \                                out_sig=[(np.complex64, self.N)], decim=self.N)\n\
      \        self.m_max = int(m_max)\n        self.K = int(n_noncoh)\n        n\
      \ = np.arange(self.N)\n        idx = np.floor(n * 1.023e6 / samp_rate).astype(int)\
      \ % 1023\n        self.cconj = {p: np.conj(np.fft.fft(ca_code(p)[idx])).astype(np.complex64)\n\
      \                      for p in range(1, 33)}\n        self.ms_list = list(range(-self.m_max,\
      \ self.m_max + 1))\n        self.prn, self.mi = 1, -1\n        self.taps = None\n\
      \        self.tracked = set()\n        self.park_prn = int(park_prn)       \
      \   # GRC callback sets these live\n        self.park_khz = int(park_khz)\n\
      \        self.warm = int(warmup_ms) // self.K * self.K   # whole windows of\
      \ warm-up\n        self.zero = np.zeros(self.N, np.complex64)\n        self.set_output_multiple(self.K)\
      \          # one call = one 20 ms window\n        self.message_port_register_in(pmt.intern('status'))\n\
      \        self.set_msg_handler(pmt.intern('status'), self._status)\n\n    def\
      \ _status(self, msg):\n        d = pmt.to_python(msg)\n        if not isinstance(d,\
      \ dict):\n            return\n        if d.get('event') in ('assign', 'assigned'):\n\
      \            self.tracked.add(int(d['prn']))\n        elif d.get('event') ==\
      \ 'lost':\n            self.tracked.discard(int(d['prn']))\n\n    def _next(self):\n\
      \        self.mi += 1\n        if self.mi >= len(self.ms_list):\n          \
      \  self.mi = 0\n            for _ in range(32):                      # next\
      \ PRN not being tracked\n                self.prn = self.prn % 32 + 1\n    \
      \            if self.prn not in self.tracked or len(self.tracked) >= 32:\n \
      \                   break\n        m = self.ms_list[self.mi]\n        self.taps\
      \ = np.roll(self.cconj[self.prn], m)\n        return m\n\n    def work(self,\
      \ input_items, output_items):\n        out = output_items[0]\n        base =\
      \ self.nitems_written(0)\n        for j in range(len(out)):\n            ms\
      \ = base + j\n            if ms < self.warm:                  # AGC / DC blocker\
      \ settling: PRN 0 = ignore\n                if ms == 0:\n                  \
      \  self.add_item_tag(0, 0, pmt.intern('acq'),\n                            \
      \          pmt.make_tuple(pmt.from_long(0), pmt.from_long(0)))\n           \
      \     out[j] = self.zero\n                continue\n            if ms % self.K\
      \ == 0 and 1 <= int(self.park_prn) <= 32:\n                # PARK mode: hold\
      \ one hypothesis so the probes can be watched\n                prn = int(self.park_prn)\n\
      \                m = int(max(-self.m_max, min(self.m_max, int(self.park_khz))))\n\
      \                self.taps = np.roll(self.cconj[prn], m)\n                self.add_item_tag(0,\
      \ ms, pmt.intern('acq'),\n                                  pmt.make_tuple(pmt.from_long(prn),\
      \ pmt.from_long(m)))\n            elif ms % self.K == 0 or self.taps is None:\n\
      \                m = self._next()\n                self.add_item_tag(0, ms,\
      \ pmt.intern('acq'),\n                                  pmt.make_tuple(pmt.from_long(self.prn),\
      \ pmt.from_long(m)))\n            out[j] = self.taps\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: 'Taps scheduler (EPB): which PRN / Doppler is tested in each 20 ms window,
      tagged'
    m_max: m_max
    maxoutbuf: '0'
    minoutbuf: '0'
    n_noncoh: n_noncoh
    park_khz: park_khz
    park_prn: park_prn
    samp_rate: samp_rate
    warmup_ms: '500'
  states:
    _io_cache: '(''GPS acq taps scheduler'', ''blk'', [(''samp_rate'', ''2048000.0''),
      (''m_max'', ''10''), (''n_noncoh'', ''20''), (''warmup_ms'', ''500''), (''park_prn'',
      ''0''), (''park_khz'', ''0'')], [(''0'', ''complex'', 1), (''status'', ''message'',
      1)], [(''0'', ''complex'', 2048)], ''GPS acq taps scheduler: conj(FFT(code))
      rotated by Doppler, tagged (prn, m)'', [''m_max'', ''park_khz'', ''park_prn''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 360]
    rotation: 0
    state: enabled
